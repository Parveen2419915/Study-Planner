<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Advanced Creative Study Planner 2025</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <section id="registrationSection" class="active">
    <h1>Create Account</h1>

    <form id="registrationForm">
      <div id="regErrorMsg" class="error-message"></div>
      <div id="regSuccessMsg" class="success-message"></div>

      <input type="text" id="regUsername" placeholder="Username" required autocomplete="off" />
      <input type="password" id="regPassword" placeholder="Password" required autocomplete="off" />
      <input type="password" id="regConfirm" placeholder="Confirm Password" required autocomplete="off" />

      <button type="submit" id="registerBtn">Register</button>

      <div class="switch-link" id="goToLogin">Already have an account? Login here</div>
    </form>
  </section>

  <section id="loginSection">
    <h1>Login</h1>
    <div id="quote"></div>

    <form id="loginForm">
      <div id="loginErrorMsg" class="error-message"></div>

      <input type="text" id="username" placeholder="Username" required autocomplete="off" />
      <input type="password" id="password" placeholder="Password" required autocomplete="off" />

      <button type="submit" id="loginBtn">Login</button>

      <div class="switch-link" id="goToRegister">New user? Register here</div>
    </form>
  </section>

  <section id="plannerSection">
    <button id="logoutBtn">Logout</button>
    <button id="darkModeToggle">Toggle Dark Mode</button>

    <h1>Creative Study Planner</h1>

    <div class="sort-container">
      Sort by:
      <select id="sortSelect">
        <option value="default">Default</option>
        <option value="priority">Priority</option>
        <option value="deadline">Deadline</option>
        <option value="completed">Completion</option>
      </select>
    </div>

    <div class="task-input-container">
      <input id="taskInput" type="text" placeholder="Enter new study task" />
      <input id="deadlineInput" type="date" title="Deadline" />
      <select id="prioritySelect" title="Priority">
        <option value="Low" selected>Low Priority</option>
        <option value="Medium">Medium Priority</option>
        <option value="High">High Priority</option>
      </select>
      <button id="addBtn">Add Task</button>
    </div>

    <div class="summary-container">
      <button id="clearCompletedBtn">Clear Completed Tasks</button>
      <span id="summary"></span>
    </div>

    <ul id="taskList"></ul>

    <div id="rewardsSection">
      <h2>Your Rewards</h2>
      <div id="pointsDisplay">Points: 0</div>
      <div id="badgesContainer"></div>
    </div>

    <div id="dailyChallenge">
      <h3>Daily Challenge:</h3>
      <p id="challengeText"></p>
    </div>

    <div id="gratitudeSection">
      <h3>Gratitude Reflection</h3>
      <textarea id="gratitudeInput" placeholder="Write 1-2 things you are grateful for today..."></textarea>
      <button id="gratitudeBtn">Save Reflection</button>
      <div id="gratitudeMessage" class="success"></div>
    </div>

    <div id="timerSection">
      <h2>Creative Timer</h2>

      <label for="timerCustomInput">Set time (seconds): </label>
      <input id="timerCustomInput" type="number" min="1" max="7200" value="1500" />

      <div id="timeDisplay">25:00</div>

      <div id="timerProgressContainer">
        <div id="timerProgressBar"></div>
      </div>

      <button id="startBtn" class="timerBtn">Start</button>
      <button id="pauseBtn" class="timerBtn" disabled>Pause</button>
      <button id="resetBtn" class="timerBtn">Reset</button>
    </div>

    <div id="themeSelector">
      <h3>Color Theme</h3>

      <label>
        <input type="radio" name="theme" value="default" checked /> Default
      </label>
      <label>
        <input type="radio" name="theme" value="dark" /> Dark
      </label>
      <label>
        <input type="radio" name="theme" value="sunset" /> Sunset
      </label>
      <label>
        <input type="radio" name="theme" value="forest" /> Forest
      </label>
    </div>
  </section>

  <audio id="happySound" src="https://actions.google.com/sounds/v1/cartoon/clang_and_wobble.ogg" preload="auto"></audio>
  <audio id="timerSound" src="https://actions.google.com/sounds/v1/alarms/alarm_clock.ogg" preload="auto"></audio>

  <script src="script.js"></script>
</body>
</html>
